#!/bin/sh
set -eu

# With a certificate and its key in /etc/will-server/tls the server listens with TLS
# too (port 17771), beside the open port 7770 that old clients still use.
TLS=/etc/will-server/tls
if [ -r "$TLS/server.crt" ] && [ -r "$TLS/server.key" ]; then
	exec /usr/bin/will-server --db-path /var/lib/will-server --tls-cert "$TLS/server.crt" --tls-key "$TLS/server.key"
fi
exec /usr/bin/will-server --db-path /var/lib/will-server
